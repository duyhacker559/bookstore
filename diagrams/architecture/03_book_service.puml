@startuml
' ─────────────────────────────────────────────────────────────────────────────
' Store Microservices – 03. Product Service Architecture
' Render: plantuml 03_book_service.puml  →  03_book_service.png
' ─────────────────────────────────────────────────────────────────────────────
title 03. Product Service Architecture
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #4f5b66
skinparam packageStyle rectangle
skinparam packageBorderColor #2c5aa0
skinparam packageBackgroundColor #f7f9fc
skinparam componentBorderColor #2c5aa0
skinparam componentBackgroundColor #ffffff
skinparam databaseBorderColor #8f5c2c
skinparam databaseBackgroundColor #fff8ef
skinparam actorBorderColor #1A376C
skinparam actorBackgroundColor #EAF2FB

actor "API Gateway" as gw
actor "cart-service\n(product validation)" as cart_svc

package "product-service  :8005" {
  component "URL Router\nurls.py" as router

  package "books app" {
    component "ProductListCreateView\nGET  /products/\nPOST /products/" as view
    component "ProductSerializer\n- title  (required)\n- author (required)\n- price  (decimal)\n- stock  (integer)" as serial
    component "Product Model\n─────────────\nid    : AutoField\ntitle : CharField\nauthor: CharField\nprice : DecimalField\nstock : IntegerField" as model
  }
}

database "product-db\n(SQLite / PostgreSQL)" as db

gw        --> router   : HTTP GET/POST /products/
cart_svc  --> router   : GET /products/ (validate product_id)
router    --> view
view      --> serial   : validate payload
serial    --> model    : save()
model     --> db       : INSERT / SELECT product
view      --> gw       : 200 OK / 201 Created
view      --> cart_svc : 200 OK  [product list for validation]

note bottom of model
  Staff creates products via POST /products/.
  cart-service calls GET /products/ to
  verify a product_id exists before adding
  it to a cart item.
end note

@enduml
